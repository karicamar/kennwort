<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Kennwort.Cli</AssemblyName>
    <RootNamespace>Kennwort.Cli</RootNamespace>

    <!-- Installable with: dotnet tool install -g Kennwort.Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kennwort</ToolCommandName>
    <PackageId>Kennwort.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Amar Karic</Authors>
    <Description>Checks a password against NIST SP 800-63B / BSI rules and Have I Been Pwned (k-anonymity).</Description>
    <PackageTags>password;security;nist;hibp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karicamar/kennwort</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kennwort\Kennwort.csproj" />
  </ItemGroup>

</Project>
